{
  "manifest_version": 3,
  "name": "KnowBefore",
  "version": "0.4.0",
  "description": "Understand a commitment before you make it. Detects locally, sends nothing until you click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["dist/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://knowbefore.ai/*", "https://www.knowbefore.ai/*", "http://localhost:3000/*"],
  "externally_connectable": {
    "matches": ["https://knowbefore.ai/*", "https://www.knowbefore.ai/*", "http://localhost:3000/*"]
  }
}
